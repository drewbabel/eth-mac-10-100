[tasks]
cover_small

[options]
cover_small: mode cover
cover_small: depth 200

[engines]
cover_small: smtbmc yices

[script]
read -sv crc.sv
read -sv synchronizer.sv
read -sv tick_gen.sv
read -sv rmii_tx.sv
read -sv rmii_rx.sv
read -formal rmii_line.sv
chparam -set PREAMBLE_BYTES 2 -set PAD_TO_BYTES 3 -set GAP_BYTES 2 -set MIN_FRAME_BYTES 7 -set MAX_FRAME_BYTES 8 -set MAX_TAGGED_FRAME_BYTES 9 rmii_line
prep -top rmii_line

[files]
rtl/crc.sv
rtl/synchronizer.sv
rtl/tick_gen.sv
rtl/rmii_tx.sv
rtl/rmii_rx.sv
rtl/rmii_line.sv
